SUPABASE_DB_HOST=your-project.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=

# DATABASE_URL is optional; if present, it takes precedence over the variables above.
# It must be a PostgreSQL/Supabase URL. SQLite is not supported.
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.axpsolhlbuohwkiaukvp.supabase.co:5432/postgres
APP_AUTH_USERNAME=capacity-admin
APP_AUTH_PASSWORD_HASH=<hash-argon2-de-la-clave>
ENVIRONMENT=development
# En desarrollo, si no se envía X-User-Role, se usa Chapter Lead.
FRONTEND_ORIGIN=http://localhost:3000
