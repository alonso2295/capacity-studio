# Supabase PostgreSQL session pooler. Keep the password outside Git.
SUPABASE_DB_HOST=aws-0-us-east-2.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.axpsolhlbuohwkiaukvp
SUPABASE_DB_PASSWORD=
# DATABASE_URL is optional; if present, it takes precedence over the variables above.
# It must be a PostgreSQL/Supabase URL. SQLite is not supported.
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.axpsolhlbuohwkiaukvp.supabase.co:5432/postgres
SUPABASE_JWT_SECRET=replace-me
ENVIRONMENT=development
# En desarrollo, si no se envía X-User-Role, se usa Chapter Lead.
FRONTEND_ORIGIN=http://localhost:3000
